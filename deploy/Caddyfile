{$SITE_DOMAIN} {
	# Caddy obtains and renews Let's Encrypt certificates automatically.
	reverse_proxy app:3000

	request_body {
		max_size 210MB
	}
}

# Staging: a live copy of whatever branch was last pushed (non-main). The
# hostname is derived from the production domain, e.g. test.fff.example.com.
# Served by the app-staging container against its own separate database.
test.{$SITE_DOMAIN} {
	reverse_proxy app-staging:3000

	request_body {
		max_size 210MB
	}
}
