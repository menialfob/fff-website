# Copy to /opt/fff-website/.env on the server and fill in.

# Domain the site is served on (Caddy uses this for HTTPS certificates).
SITE_DOMAIN=fff.example.com

# Secret for signing session tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Canonical URL of the site.
AUTH_URL=https://fff.example.com
AUTH_TRUST_HOST=true

# First admin account, created automatically on first start with an empty
# database. Change the password from the profile page after logging in.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
