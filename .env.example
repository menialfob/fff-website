# Copy to .env for local development.

# SQLite database location. In production (Docker) this is file:/data/db/app.db
DATABASE_URL="file:./dev.db"

# Secret for signing session tokens. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Where uploaded files are stored. In production (Docker) this is /data/uploads
UPLOAD_DIR="./uploads"

# Canonical URL of the site, e.g. https://example.com (used by auth redirects)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Spotify app credentials (https://developer.spotify.com/dashboard) used by
# Klub 100 for server-side track search and the per-user connect flow that
# powers live playback hosting. Optional — search shows a notice when unset.
# Leave the values unquoted: docker compose `env_file` passes quote
# characters through literally and Spotify then rejects the credential.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# OAuth redirect URI for the per-user Spotify connect flow. Defaults to
# AUTH_URL + /api/spotify/callback, which is right in production. Spotify
# rejects http://localhost, so for local dev set this to the loopback IP,
# register it in the dashboard, and open the site via http://127.0.0.1:3000:
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
SPOTIFY_REDIRECT_URI=

# Web Push (browser notifications). Generate a keypair once with:
#   npx web-push generate-vapid-keys
# The public key is exposed to the browser (NEXT_PUBLIC_); the private key is a
# secret and must only live in the server env. Notifications are disabled when
# these are unset (sends become no-ops), so they are optional for local dev.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address push services can reach you at (any mailto: you own).
VAPID_SUBJECT=mailto:admin@fffloge.dk

# Tenor v2 API key for the chat GIF picker (https://developers.google.com/tenor).
# Optional — the GIF button is hidden when unset.
TENOR_API_KEY=""
