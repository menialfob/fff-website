# Copy to .env for local development.

# SQLite database location. In production (Docker) this is file:/data/db/app.db
DATABASE_URL="file:./dev.db"

# Secret for signing session tokens. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Where uploaded files are stored. In production (Docker) this is /data/uploads
UPLOAD_DIR="./uploads"

# Canonical URL of the site, e.g. https://example.com (used by auth redirects)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Spotify app credentials (https://developer.spotify.com/dashboard) used by
# Klub 100 for server-side track search. Optional — search shows a notice
# when unset. Leave the values unquoted: docker compose `env_file` passes
# quote characters through literally and Spotify then rejects the credential.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
