generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

// Additional, independent roles a user can hold besides the ADMIN/MEMBER
// admin flag. Mirrored as a string-literal union in src/lib/roles.ts, which
// the edge-safe auth config uses — keep the two in sync.
enum ExtraRole {
  BESTYRELSE
}

// Elected board titles — each is held by at most one bestyrelse member at a
// time (enforced by the unique constraint on UserRole.title). Mirrored as a
// string-literal union in src/lib/roles.ts — keep the two in sync.
enum BestyrelseTitle {
  FARMAND
  BEDSTEFAR
  SUKKERFAR
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         Role       @default(MEMBER)
  bio          String?
  // Profile picture: name of the processed 512px webp inside UPLOAD_DIR
  // (served via /api/avatar/[userId]); avatarUpdatedAt cache-busts the URL.
  avatarStoredName String?
  avatarUpdatedAt  DateTime?
  // Deactivated users keep their account and content but cannot log in.
  isActive     Boolean    @default(true)
  // Secret for the personal iCal subscription feed (/api/calendar/feed/…).
  // Null until the member enables the feed; regenerating it revokes old URLs.
  calendarToken String?   @unique
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  extraRoles   UserRole[]
  auditLogs    AuditLog[]
  sectionViews SectionView[]
  folderViews  FolderView[]
  files        FileItem[]
  folders      Folder[]
  calendarEvents CalendarEvent[]
  forumThreads ForumThread[]
  forumPosts   ForumPost[]
  klub100Projects Klub100Project[]
  klub100Songs    Klub100Song[]
  klub100Cheers   Klub100Cheers[]
  klub100DefaultCheers Klub100DefaultCheers[]
  klub100Votes    Klub100Vote[]
  klub100ProjectAdminOf Klub100ProjectAdmin[]
  spotifyAccount  SpotifyAccount?
  // Person-type structured field values pointing at this member.
  occurrenceFieldValues OccurrenceFieldValue[]
  // The member's attendance registrations on specific event instances.
  attendances     EventAttendance[]
  // Web Push (browser notification) subscriptions — one per installed
  // browser/device the member enabled notifications on.
  pushSubscriptions PushSubscription[]
  // Which kinds of notification the member wants (per account, not device).
  pushPreferences   PushPreference[]
  // Chat: messages authored, reactions given, polls created + voted on,
  // per-conversation read cursors, and DM/group memberships.
  messages         Message[]
  messageReactions MessageReaction[]
  pollsCreated     Poll[]
  pollVotes        PollVote[]
  conversationReads ConversationRead[]
  conversationMemberships ConversationMember[]
  conversationsCreated    Conversation[]
  messageAttachments      MessageAttachment[]
  messageMentions         MessageMention[]
}

model UserRole {
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      ExtraRole
  // Only meaningful on BESTYRELSE rows; lives here so a title can never
  // outlive the role (revoking bestyrelse deletes the row and the title).
  title     BestyrelseTitle? @unique
  createdAt DateTime  @default(now())

  @@id([userId, role])
}

// Usage log shown to admins. `action` is a stable key (e.g. "user.rename")
// looked up in the i18n dictionaries at display time; `meta` is a JSON string
// (SQLite has no Json type) that snapshots names so rows still render after
// the actor or target is deleted. Rows are written via logEvent() in
// src/lib/audit.ts.
model AuditLog {
  id         String   @id @default(cuid())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  meta       String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Per-user "last visited" timestamp for a dashboard section ("forum" |
// "calendar" | "files"), upserted when the member opens that section. The
// home page compares it against content timestamps to show unread badges and
// a recent-activity list; the admin Users tab shows it as a last-seen line.
model SectionView {
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  section String
  seenAt  DateTime @default(now())

  @@id([userId, section])
}

// A single Web Push subscription (browser endpoint + encryption keys) for a
// member's installed PWA / browser. Created when they enable notifications;
// pruned automatically when the push service reports it expired (410/404).
// `endpoint` is globally unique so re-subscribing the same browser upserts
// rather than duplicating. Keyed material is opaque and safe to store.
model PushSubscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

// One notification category the member has an opinion about. Categories are
// the string-literal union in src/lib/push-categories.ts (chat, mentions,
// forum, calendar, …) — a free-text column rather than an enum so a new
// module only has to extend that list, exactly like SectionView.section.
//
// Rows are written only when a member touches a toggle: a missing row means
// "on", so both new members and newly added categories start opted in and
// nobody silently stops hearing about a feature that ships later.
//
// Preferences are per account, not per device — the filtering happens on the
// server before a push is sent (see src/lib/push.ts), because a push that
// arrives and shows no notification costs the subscription itself.
model PushPreference {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  category  String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@id([userId, category])
}

// ── Chat ───────────────────────────────────────────────────────────────────
// What kind of conversation a row is. CHANNEL = shared, access computed from
// `requiredRole` (everyone when null, plus admins) — no membership rows. DM
// and GROUP materialize their membership in ConversationMember.
enum ConversationType {
  CHANNEL
  DM
  GROUP
}

// A chat conversation: a shared channel (e.g. "general", "bestyrelse"), a 1:1
// DM, or a user-created group. `key` is the stable URL slug for seeded
// channels only (DMs/groups are addressed by id). `dmKey` dedupes DMs: the
// two member ids sorted and joined with ":", unique so a pair has exactly one
// DM. `name` is null for DMs (the UI shows the other member's name).
model Conversation {
  id           String    @id @default(cuid())
  type         ConversationType @default(CHANNEL)
  key          String?   @unique
  name         String?
  description  String?
  order        Int       @default(0)
  requiredRole ExtraRole?
  dmKey        String?   @unique
  createdBy    User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById  String?
  // Denormalized timestamp of the newest message, for ordering the
  // conversation list without a per-row scan.
  lastMessageAt DateTime?
  createdAt    DateTime  @default(now())

  messages Message[]
  polls    Poll[]
  reads    ConversationRead[]
  members  ConversationMember[]

  @@index([order])
}

// Membership of one user in a DM or GROUP conversation (channels compute
// access from roles instead). `isAdmin` marks group admins (the creator);
// admins rename the group and add/remove members.
model ConversationMember {
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  isAdmin        Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@id([conversationId, userId])
  @@index([userId])
}

// A single chat message. `body` is plain text (chat-style, not rich Tiptap
// like the forum). A message may instead/also carry a poll (see Poll.message)
// or reference a calendar occurrence as an event card. Author is SetNull so
// messages survive account deletion. Deleting a message tombstones it
// (`deletedAt` set, body blanked) rather than removing the row, so reply
// quotes keep pointing at something. `clientId` echoes the sender's optimistic
// id back through SSE; `searchText` is the locale-lowercased body maintained
// on every write for LIKE search (SQLite lower() is ASCII-only).
model Message {
  id             String   @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  author         User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId       String?
  body           String
  clientId       String?
  editedAt       DateTime?
  deletedAt      DateTime?
  searchText     String?
  createdAt      DateTime @default(now())

  // Reply/quote target. SetNull keeps the reply if the original row ever
  // disappears (deletes normally tombstone instead of removing rows).
  replyTo   Message?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replyToId String?
  replies   Message[] @relation("MessageReply")

  // Optional shared calendar event: rendered as an event card with a Sign-up
  // deep link. Keyed by event + date (attendance is per eventId+date, and an
  // occurrence row may not exist yet). SetNull so the message survives if the
  // event is deleted; `eventDate` is the "YYYY-MM-DD" instance.
  event     CalendarEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId   String?
  eventDate String?

  reactions   MessageReaction[]
  poll        Poll?
  attachments MessageAttachment[]
  mentions    MessageMention[]

  @@index([conversationId, createdAt])
}

enum AttachmentKind {
  IMAGE
  FILE
  GIF
}

// Media/file attached to a chat message. Uploaded ahead of the send (two
// phase: POST /api/chat/upload creates the row with messageId null, then
// sendMessage claims it), so progress is real and a failed send never leaves
// media in a message. Chat media is deliberately separate from FileItem —
// it must not clutter the Files section. Served only through the auth-gated
// /api/chat/media/[id] route. `thumbName` and `blurData` (tiny webp data URL)
// exist for images/GIFs; unclaimed rows older than a day are garbage
// collected by the upload route.
model MessageAttachment {
  id           String   @id @default(cuid())
  message      Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId    String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById String?
  kind         AttachmentKind
  name         String
  storedName   String   @unique
  thumbName    String?
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  blurData     String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([messageId])
  @@index([uploadedById, messageId])
}

// An @mention of a member inside a message body. Offsets into the stored
// body (computed server-side by scanning for "@Name" at write time), so
// highlighting survives later renames. Recomputed on edit.
model MessageMention {
  id        String  @id @default(cuid())
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  offset    Int
  length    Int

  @@index([messageId])
  @@index([userId])
}

// One emoji reaction by one user on one message. Toggling adds/removes the row.
model MessageReaction {
  id        String   @id @default(cuid())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// A quick poll, always attached to a carrier message (Poll.messageId). When
// `multiple` is false the app enforces a single vote per user across options.
model Poll {
  id             String    @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  message        Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId      String    @unique
  question       String
  multiple       Boolean   @default(false)
  closesAt       DateTime?
  createdBy      User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById    String?
  createdAt      DateTime  @default(now())

  options PollOption[]
}

model PollOption {
  id     String @id @default(cuid())
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId String
  text   String
  order  Int    @default(0)

  votes PollVote[]

  @@index([pollId])
}

model PollVote {
  id       String     @id @default(cuid())
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionId String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  createdAt DateTime  @default(now())

  @@unique([optionId, userId])
  @@index([optionId])
}

// Per-user, per-conversation read cursor for unread badges and seen-by
// receipts. `muted` silences normal push notifications for the conversation
// (mentions still push; unread counts are unaffected).
model ConversationRead {
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  lastReadAt     DateTime @default(now())
  muted          Boolean  @default(false)

  @@id([userId, conversationId])
}

// Per-user Spotify connection (Authorization Code + PKCE). Only needed to
// *host* Klub 100 playback; capped at 5 accounts by Spotify's dev-mode
// allowlist (see docs/klub100-prd.md §6.3).
model SpotifyAccount {
  userId        String    @id
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  spotifyUserId String
  refreshToken  String
  accessToken   String?
  expiresAt     DateTime?
  // "premium" | "free" | … — hosting playback requires premium.
  product       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Where a folder came from. USER folders are the browsable tree in the files
// section; ATTACHMENT folders are created implicitly to hold the assets of a
// calendar event/occurrence or a forum thread and are listed apart from the
// tree, so tidying the files section never disturbs another module's content.
enum FolderKind {
  USER
  ATTACHMENT
}

// Nestable folders for the files section. Deleting a folder never deletes its
// contents: the SetNull relations promote both its files and its child folders
// to the deleted folder's own parent. ATTACHMENT folders sit outside the tree
// (always parentId null) and are managed by the module that owns them.
model Folder {
  id          String     @id @default(cuid())
  name        String
  kind        FolderKind @default(USER)
  parent      Folder?    @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  parentId    String?
  children    Folder[]   @relation("FolderTree")
  createdBy   User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  files       FileItem[]
  views       FolderView[]
  event       CalendarEvent?
  occurrence  CalendarOccurrence?
  forumThread ForumThread?
  createdAt   DateTime   @default(now())

  @@index([kind, parentId, name])
}

// Per-folder read cursor behind the unread badges in the files section: when
// this member last opened this folder. One row per folder they have actually
// been in — a missing row means "never opened", and the badge then counts from
// the later of the member's join date and the folder's own creation, so a new
// member is not greeted by a number on every folder in the archive.
model FolderView {
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  folder   Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId String
  seenAt   DateTime @default(now())

  @@id([userId, folderId])
}

enum CalendarEventKind {
  ADHOC
  RECURRING
}

// The three supported recurrence patterns. Occurrence dates are computed in
// src/modules/calendar/recurrence.ts and emitted as native RRULEs in the
// iCal feed — keep the three places consistent.
enum RecurrenceFreq {
  MONTHLY_NTH_WEEKDAY // e.g. first Wednesday of every month
  YEARLY_NTH_WEEKDAY // e.g. first Friday of March, every year
  YEARLY_FIXED_DATE // e.g. every 24 December
}

// All times are Danish wall-clock, never UTC: `date` is "YYYY-MM-DD" and
// startMinutes counts from local midnight. The iCal feed pairs them with
// TZID=Europe/Copenhagen, so DST conversion is entirely the calendar
// client's job.
model CalendarEvent {
  id              String            @id @default(cuid())
  kind            CalendarEventKind
  title           String
  // ADHOC only — TipTap document as a JSON string (SQLite has no Json
  // type). Recurring events keep their content per occurrence date in
  // CalendarOccurrence instead, so each year/month starts blank.
  contentJson     String?
  location        String?
  allDay          Boolean           @default(true)
  // Wall-clock minutes since Danish midnight on the first/last day of the
  // event (null when allDay). endMinutes may be earlier than startMinutes
  // when the event ends on a later day.
  startMinutes    Int?
  endMinutes      Int?
  // ADHOC only: first and (for multi-day events) last calendar day.
  date            String?
  endDate         String?
  // RECURRING only: days the event continues past its occurrence date
  // (0/null = single-day, 2 = Friday→Sunday).
  endDayOffset    Int?
  // RECURRING only ↓
  freq            RecurrenceFreq?
  // ISO weekday, 1 = Monday … 7 = Sunday (nth-weekday patterns).
  weekday         Int?
  // 1..4, or -1 for the last weekday of the month (nth-weekday patterns).
  ordinal         Int?
  // 1..12 — the month for the two yearly patterns.
  month           Int?
  // 1..31 — day of month for YEARLY_FIXED_DATE.
  dayOfMonth      Int?
  // ADHOC only — folder in the files section holding the event's images
  // and attachments (recurring events use per-occurrence folders).
  folder          Folder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  folderId        String?           @unique
  // SetNull (unlike FileItem's Cascade): events are group content and must
  // outlive their author.
  createdBy       User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById     String?
  occurrences     CalendarOccurrence[]
  // Per-instance attendance registrations (keyed by instance date, not by
  // occurrence row — see EventAttendance).
  attendances     EventAttendance[]
  // RECURRING only — the structured field definitions shared by the series.
  // Each occurrence date fills in values (OccurrenceFieldValue).
  fields          EventField[]
  // The Begivenheder forum thread mirroring this event (both ad hoc and
  // recurring events get one). SetNull on the thread side keeps the
  // discussion as an archive after the event is deleted.
  forumThread     ForumThread?
  // Chat messages that shared this event as an event card.
  chatMessages    Message[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([kind, date])
}

// A member's RSVP to one specific instance of an event. GOING / MAYBE /
// NOT_GOING — Danish "Deltager / Deltager måske / Deltager ikke".
enum AttendanceStatus {
  GOING
  MAYBE
  NOT_GOING
}

// One member's attendance registration for a single event instance. The
// instance is identified by its wall-clock date ("YYYY-MM-DD"), not by a
// CalendarOccurrence row: recurring events are attended per occurrence date
// (validated against the recurrence rule), while ad hoc events have a single
// instance whose date equals the event's own `date`. Keying on the date
// string means registering never has to lazily materialize an occurrence row.
model EventAttendance {
  id        String           @id @default(cuid())
  event     CalendarEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  date      String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([eventId, date, userId])
  @@index([eventId, date])
}

// Per-date content of a RECURRING event. The series shares rule/title/time,
// but description and assets belong to a single occurrence — the row (and
// its folder, named "{title} {date}") is created lazily the first time
// someone saves content for that date.
model CalendarOccurrence {
  id          String        @id @default(cuid())
  event       CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String
  // "YYYY-MM-DD"; always validated against the event's recurrence rule.
  date        String
  contentJson String?
  folder      Folder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  folderId    String?       @unique
  // The Begivenheder forum thread mirroring this specific instance (created
  // when the occurrence is first edited). SetNull on the thread side keeps the
  // discussion as an archive after the occurrence/series is deleted.
  forumThread ForumThread?
  // Values for the series' structured fields on this specific date.
  fieldValues OccurrenceFieldValue[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([eventId, date])
}

// A structured field defined on a RECURRING series (e.g. "Arrangør 1",
// "Agenda"). The definition lives on the event; each occurrence date supplies
// its own value in OccurrenceFieldValue. Type is fixed once created — to change
// it, delete and re-add the field (which cascades its values away).
enum EventFieldType {
  PERSON // pick one member
  TEXT // single line of text
  DOCUMENT // an uploaded file (FileItem)
}

model EventField {
  id       String         @id @default(cuid())
  event    CalendarEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId  String
  label    String
  type     EventFieldType
  // Display order within the series; reconciled from the editor's list index.
  position Int
  values   OccurrenceFieldValue[]

  @@index([eventId])
}

// One field's value on one occurrence date. Exactly one of text/person/file is
// meaningful, matching the field's type; all are optional (fields are never
// mandatory). A deleted member/file leaves the row but nulls the reference
// (SetNull) so it simply renders as empty.
model OccurrenceFieldValue {
  id           String             @id @default(cuid())
  occurrence   CalendarOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  occurrenceId String
  field        EventField         @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  fieldId      String
  text         String?
  person       User?              @relation(fields: [personId], references: [id], onDelete: SetNull)
  personId     String?
  file         FileItem?          @relation(fields: [fileId], references: [id], onDelete: SetNull)
  fileId       String?

  @@unique([occurrenceId, fieldId])
  @@index([fieldId])
}

// How a file is presented. Derived from the MIME type and extension at upload
// time by kindFor() in src/modules/files/kind.ts — the single classifier the
// upload route, the browser grid and the viewer all agree on.
enum FileKind {
  IMAGE
  VIDEO
  AUDIO
  PDF
  DOC
  OTHER
}

model FileItem {
  id           String   @id @default(cuid())
  // Original filename as uploaded, for display and download.
  name         String
  // Name of the file on disk inside UPLOAD_DIR (randomized, never user-controlled).
  storedName   String   @unique
  mimeType     String
  size         Int
  kind         FileKind @default(OTHER)
  // 512px webp preview: the downscaled image, or a video's poster frame
  // (captured in the browser at upload — the server has no ffmpeg). Missing
  // thumbnails for images are filled in lazily by the media route.
  thumbName    String?
  // 2048px webp shown by the full-screen viewer, when the original is larger.
  // A camera JPEG is ~10 MB; this is a few hundred KB, so a photo opens
  // sharp straight away instead of decoding grey band by grey band. The
  // original is fetched only when someone zooms in. Filled in lazily by the
  // media route for files that predate it, same as thumbnails.
  displayName  String?
  // 16px webp data URL rendered under the thumbnail so grids never reflow.
  blurData     String?
  // Intrinsic pixel size, for aspect-ratio boxes in the grid and viewer.
  width        Int?
  height       Int?
  // Playback length of video/audio, measured client-side at upload.
  durationMs   Int?
  // Files are group content and outlive their uploader: a photo inside
  // somebody else's event or thread must not vanish when its uploader's
  // account is deleted. An orphaned file is attributed to nobody and only an
  // admin can delete it.
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById String?
  folder       Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  folderId     String?
  createdAt    DateTime @default(now())
  // Document-type structured field values pointing at this file.
  occurrenceFieldValues OccurrenceFieldValue[]

  @@index([folderId, createdAt])
}

enum Klub100SongStatus {
  SUGGESTED
  ACCEPTED
  REJECTED
}

enum Klub100Placement {
  EARLY
  MIDDLE
  LATE
}

model Klub100Project {
  id          String        @id @default(cuid())
  name        String
  // A mix is built collectively — everyone's songs, cheers and votes hang off
  // it — so it outlives the member who started it.
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  songs       Klub100Song[]
  admins      Klub100ProjectAdmin[]
  playbackState Klub100PlaybackState?
  // Playback settings curators can tune (see src/modules/klub100/shared.ts for
  // the allowed range). Fades are applied per segment: in when the song drops,
  // out before the cut point.
  fadeInMs    Int           @default(1000)
  fadeOutMs   Int           @default(1000)
  // Optional recorded clip used for songs that have no cheers of their own;
  // when absent the bundled /default-cheers.wav plays instead.
  defaultCheers Klub100DefaultCheers?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// The project's own "no cheers recorded" clip. One row per project, replacing
// the bundled default in playback and in the export package.
model Klub100DefaultCheers {
  id           String         @id @default(cuid())
  project      Klub100Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String         @unique
  // Name of the file on disk inside UPLOAD_DIR (randomized, never user-controlled).
  storedName   String         @unique
  mimeType     String
  size         Int
  recordedBy   User?          @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  recordedById String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// Extra members the project creator has granted curator rights to. The creator
// is always an implicit admin and is never stored here. Site-wide ADMINs also
// curate every project, independent of these rows.
model Klub100ProjectAdmin {
  project   Klub100Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime       @default(now())

  @@id([projectId, userId])
}

// Crash-safe resume for live playback: where the mix got to, persisted after
// every segment/cheers transition. One row per project; cleared on finish or
// "start over". songId is not a relation — a deleted song just means the
// resume offer falls back to the start.
model Klub100PlaybackState {
  projectId String         @id
  project   Klub100Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  songId    String
  segmentNo Int            @default(1)
  updatedAt DateTime       @updatedAt
}

model Klub100Song {
  id            String            @id @default(cuid())
  project       Klub100Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  // An accepted song holds a numbered slot on the tracklist; deleting the
  // member who suggested it would leave a gap, so the row stays, unattributed.
  suggestedBy   User?             @relation(fields: [suggestedById], references: [id], onDelete: SetNull)
  suggestedById String?
  status        Klub100SongStatus @default(SUGGESTED)
  // 1-based tracklist position while ACCEPTED, kept contiguous; null otherwise.
  position      Int?

  // Spotify metadata snapshot taken at suggestion time, so lists render
  // without live Spotify calls.
  spotifyTrackId String
  spotifyUrl     String
  title          String
  artist         String
  album          String
  durationMs     Int
  albumArtUrl    String?

  // Selected ~1 minute segment, plus an optional second one ("2×1 minute").
  seg1StartMs Int
  seg1EndMs   Int
  seg2StartMs Int?
  seg2EndMs   Int?

  // Suggester's hint for where the song belongs in the mix.
  placement     Klub100Placement?
  placementNote String?

  cheers    Klub100Cheers?
  votes     Klub100Vote[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([projectId, spotifyTrackId])
}

model Klub100Cheers {
  id           String      @id @default(cuid())
  song         Klub100Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId       String      @unique
  // Name of the file on disk inside UPLOAD_DIR (randomized, never user-controlled).
  storedName   String      @unique
  mimeType     String
  size         Int
  recordedBy   User?       @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  recordedById String?
  createdAt    DateTime    @default(now())
}

model Klub100Vote {
  song      Klub100Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime    @default(now())

  @@id([songId, userId])
}

// A forum section. Ordinary categories are admin-managed (name/description in
// the DB). The single `isEvents` category ("Begivenheder") is seeded lazily,
// mirrors calendar events, cannot be deleted, and rejects manually-created
// threads; the UI shows an i18n label for it instead of `name`.
model ForumCategory {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  order       Int           @default(0)
  isEvents    Boolean       @default(false)
  threads     ForumThread[]
  createdAt   DateTime      @default(now())
}

// A discussion topic. A normal thread's first post is its body. A thread linked
// to an ad hoc event (via eventId) or a single recurring instance (via
// occurrenceId) instead renders that live event/occurrence on top and holds
// member replies below.
model ForumThread {
  id          String        @id @default(cuid())
  category    ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  title       String
  pinned      Boolean       @default(false)
  locked      Boolean       @default(false)
  // Ad hoc events link here; recurring events link per instance via
  // occurrenceId below. SetNull keeps the discussion after the event is deleted.
  event       CalendarEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId     String?       @unique
  // A single recurring-event instance. The thread's title is the series title;
  // the date comes from the occurrence. SetNull keeps the discussion after the
  // occurrence/series is deleted.
  occurrence   CalendarOccurrence? @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)
  occurrenceId String?             @unique
  // Lazy folder in the files section holding images/attachments from the
  // thread's posts (created on first upload; SetNull keeps assets discoverable
  // once the thread is gone).
  folder      Folder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  folderId    String?       @unique
  // SetNull: forum content is group content and outlives its author.
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  posts       ForumPost[]
  createdAt   DateTime      @default(now())
  // Bumped on every new reply so category listings can sort by recent activity.
  updatedAt   DateTime      @updatedAt

  @@index([categoryId, updatedAt])
}

model ForumPost {
  id          String      @id @default(cuid())
  thread      ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId    String
  // TipTap document as a JSON string (SQLite has no Json type).
  contentJson String
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  // Set when the post has been edited after creation.
  editedAt    DateTime?

  @@index([threadId, createdAt])
}
